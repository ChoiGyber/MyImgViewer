{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyImgViewer",
  "version": "2.0.0",
  "identifier": "com.myimgviewer.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MyImgViewer",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "fileAssociations": [
      { "ext": ["jpg", "jpeg", "jpe", "jfif", "pjpeg", "pjp"], "mimeType": "image/jpeg", "description": "JPEG Image", "role": "Viewer" },
      { "ext": ["png", "apng"], "mimeType": "image/png", "description": "PNG Image", "role": "Viewer" },
      { "ext": ["webp"], "mimeType": "image/webp", "description": "WebP Image", "role": "Viewer" },
      { "ext": ["avif"], "mimeType": "image/avif", "description": "AVIF Image", "role": "Viewer" },
      { "ext": ["tiff", "tif"], "mimeType": "image/tiff", "description": "TIFF Image", "role": "Viewer" },
      { "ext": ["gif"], "mimeType": "image/gif", "description": "GIF Image", "role": "Viewer" },
      { "ext": ["bmp", "dib"], "mimeType": "image/bmp", "description": "BMP Image", "role": "Viewer" },
      { "ext": ["svg"], "mimeType": "image/svg+xml", "description": "SVG Image", "role": "Viewer" },
      { "ext": ["ico"], "mimeType": "image/x-icon", "description": "Icon Image", "role": "Viewer" },
      { "ext": ["heic", "heics"], "mimeType": "image/heic", "description": "HEIC Image", "role": "Viewer" },
      { "ext": ["heif", "heifs", "hif"], "mimeType": "image/heif", "description": "HEIF Image", "role": "Viewer" },
      { "ext": ["tga", "targa"], "mimeType": "image/x-tga", "description": "TGA Image", "role": "Viewer" },
      { "ext": ["pnm", "pbm", "pgm", "ppm", "pam"], "mimeType": "image/x-portable-anymap", "description": "PNM Image", "role": "Viewer" },
      { "ext": ["qoi"], "mimeType": "image/x-qoi", "description": "QOI Image", "role": "Viewer" },
      { "ext": ["dds"], "mimeType": "image/vnd-ms.dds", "description": "DDS Image", "role": "Viewer" },
      { "ext": ["hdr"], "mimeType": "image/vnd.radiance", "description": "Radiance HDR Image", "role": "Viewer" },
      { "ext": ["exr"], "mimeType": "image/x-exr", "description": "OpenEXR Image", "role": "Viewer" },
      { "ext": ["ff", "farbfeld"], "mimeType": "application/octet-stream", "description": "Farbfeld Image", "role": "Viewer" }
    ]
  }
}
