{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyImgViewer",
  "version": "1.0.0",
  "identifier": "com.myimgviewer.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MyImgViewer",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      { "ext": ["jpg", "jpeg"], "mimeType": "image/jpeg", "description": "JPEG Image" },
      { "ext": ["png"], "mimeType": "image/png", "description": "PNG Image" },
      { "ext": ["webp"], "mimeType": "image/webp", "description": "WebP Image" },
      { "ext": ["gif"], "mimeType": "image/gif", "description": "GIF Image" },
      { "ext": ["bmp"], "mimeType": "image/bmp", "description": "BMP Image" },
      { "ext": ["avif"], "mimeType": "image/avif", "description": "AVIF Image" },
      { "ext": ["tiff", "tif"], "mimeType": "image/tiff", "description": "TIFF Image" }
    ]
  }
}
