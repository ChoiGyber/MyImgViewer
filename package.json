{
  "name": "myimgviewer",
  "version": "2.1.0",
  "description": "MyImgViewer",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify:file-associations": "node scripts/verify-file-associations.mjs",
    "verify:update-logic": "node scripts/verify-update-logic.mjs",
    "verify:heic-conversion": "node scripts/verify-heic-conversion-pipeline.mjs",
    "verify:folder-batch": "node scripts/verify-folder-batch-actions.mjs",
    "verify:print-layout": "node scripts/verify-print-layout.mjs",
    "verify:tauri-print-dialog-ui": "node scripts/verify-tauri-print-dialog-ui.mjs",
    "verify:tauri-keyboard-shortcuts": "node scripts/verify-tauri-keyboard-shortcuts.mjs",
    "verify:tauri-app-print-shortcut": "node scripts/verify-tauri-app-print-shortcut-wiring.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "heic-convert": "^2.1.0",
    "sharp": "^0.33.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "eslint": "^9.14.0",
    "js-yaml": "^5.3.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
